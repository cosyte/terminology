        "simple/valueset-filter-regex-prop.json",
        "simple/valueset-filter-regex-none.json",
        "simple/valueset-filter-repeating-property.json"
      ],
      "tests": [
        {
          "name": "simple-expand-all",
          "description": "Expansion containing all the code system",
          "operation": "expand",
          "request": "simple/simple-expand-all-request-parameters.json",
          "response": "simple/simple-expand-all-response-valueSet.json"
        },
        {
          "name": "simple-expand-active",
          "description": "Expansion containing only the active codes in the code system",
          "operation": "expand",
          "request": "simple/simple-expand-active-request-parameters.json",
          "response": "simple/simple-expand-active-response-valueSet.json"
        },
        {
          "name": "simple-expand-inactive",
          "description": "Expansion containing only the inactive codes in the code system",
          "operation": "expand",
          "request": "simple/simple-expand-inactive-request-parameters.json",
          "response": "simple/simple-expand-inactive-response-valueSet.json"
        },
        {
          "name": "simple-expand-enum",
          "description": "Expansion containing an enumerated set of codes in the code system",
          "operation": "expand",
          "request": "simple/simple-expand-enum-request-parameters.json",
          "response": "simple/simple-expand-enum-response-valueSet.json"
        },
        {
          "name": "simple-expand-enum-bad",
          "description": "Expansion containing an enumerated set of codes in the code system, including invalid codes",
          "operation": "expand",
          "request": "simple/simple-expand-enum-bad-request-parameters.json",
          "response": "simple/simple-expand-enum-bad-response-valueSet.json"
        },
        {
          "name": "simple-expand-isa",
          "description": "Expansion containing a filter on the code system using is-a relationship",
          "operation": "expand",
          "request": "simple/simple-expand-isa-request-parameters.json",
          "response": "simple/simple-expand-isa-response-valueSet.json"
        },
        {
          "name": "simple-expand-child-of",
          "description": "Expansion containing a filter on the code system using child-of relationship. This is testing R5/R4 transformation",
          "operation": "expand",
          "request": "simple/simple-expand-child-of-request-parameters.json",
          "response": "simple/simple-expand-child-of-response-valueSet.json"
        },
        {
          "name": "simple-expand-isa-o2",
          "description": "Expansion containing a filter on the code system using is-a relationship with paging (tx.fhir.org internal test)",
          "mode": "tx.fhir.org",
          "operation": "expand",
          "request": "simple/simple-expand-isa-o2-request-parameters.json",
          "response": "simple/simple-expand-isa-o2-response-valueSet.json"
        },
        {
          "name": "simple-expand-isa-c2",
          "description": "Expansion containing a filter on the code system using is-a relationship with paging (tx.fhir.org internal test)",
          "mode": "tx.fhir.org",
          "operation": "expand",
          "request": "simple/simple-expand-isa-c2-request-parameters.json",
          "response": "simple/simple-expand-isa-c2-response-valueSet.json"
        },
        {
          "name": "simple-expand-isa-o2c2",
          "description": "Expansion containing a filter on the code system using is-a relationship with paging (tx.fhir.org internal test)",
          "mode": "tx.fhir.org",
          "operation": "expand",
          "request": "simple/simple-expand-isa-o2c2-request-parameters.json",
          "response": "simple/simple-expand-isa-o2c2-response-valueSet.json"
        },
        {
          "name": "simple-expand-prop",
          "description": "Expansion containing a filter on the code system using a property value",
          "operation": "expand",
          "request": "simple/simple-expand-prop-request-parameters.json",
          "response": "simple/simple-expand-prop-response-valueSet.json"
        },
        {
          "name": "simple-expand-repeating-prop",
          "description": "A concept may carry several values for one property (CodeSystem.concept.property is 0..*). code3 has dup=alpha and dup=beta; filtering on beta - which is not its first value - must still select it",
          "operation": "expand",
          "request": "simple/simple-expand-repeating-prop-request-parameters.json",
          "response": "simple/simple-expand-repeating-prop-response-valueSet.json"
        },
        {
          "name": "simple-expand-repeating-prop-values",
          "description": "expansion.contains.property is 0..* as well: a concept carrying several values for one property must report all of them, not just one",
          "operation": "expand",
          "request": "simple/simple-expand-repeating-prop-values-request-parameters.json",
          "response": "simple/simple-expand-repeating-prop-values-response-valueSet.json"
        },
        {
          "name": "simple-expand-regex",
          "description": "Expansion containing a filter on the code system using regex on the codes",
          "operation": "expand",
          "request": "simple/simple-expand-regex-request-parameters.json",
          "response": "simple/simple-expand-regex-response-valueSet.json"
        },
        {
          "name": "simple-expand-regex2",
          "description": "Expansion containing a filter on the code system using regex on the codes using a regex known to cause a problem on at least one server",
          "operation": "expand",
          "request": "simple/simple-expand-regex2-request-parameters.json",
          "response": "simple/simple-expand-regex2-response-valueSet.json"
        },
        {
          "name": "simple-expand-regexp-prop",
          "description": "Expansion containing a filter on the code system using regex on the property values of prop",
          "operation": "expand",
          "request": "simple/simple-expand-regex-prop-request-parameters.json",
          "response": "simple/simple-expand-regex-prop-response-valueSet.json"
        },
        {
          "name": "simple-expand-regex-none",
          "description": "Expansion containing a filter on the code system using a valid regex on the codes that matches none of them. The expansion is empty - an include whose filter selects nothing must not be treated as an include with no filter, which would select every code in the code system",
          "operation": "expand",
          "request": "simple/simple-expand-regex-none-request-parameters.json",
          "response": "simple/simple-expand-regex-none-response-valueSet.json"
        },
        {
          "name": "simple-lookup-1",
          "description": "Check that $lookup works (there's not many tests for $lookup because it's not used much by the tools)",
          "operation": "lookup",
          "request": "simple/simple-lookup-request-parameters.json",
          "response": "simple/simple-lookup-response-parameters.json"
        },
        {
          "name": "simple-lookup-2",
          "description": "Check that $lookup works (there's not many tests for $lookup because it's not used much by the tools)",
          "operation": "lookup",
          "request": "simple/simple-lookup2-request-parameters.json",
          "response": "simple/simple-lookup2-response-parameters.json"
        },
