{
  "suites": [
    {
      "name": "simple-cases",
      "mode": "general",
      "description": "basic tests, setting up for the API tests to come",
      "setup": [
        "simple/codesystem-simple.json",
        "simple/valueset-all.json",
        "simple/valueset-active.json",
        "simple/valueset-inactive.json",
        "simple/valueset-enumerated.json",
        "simple/valueset-enumerated-bad.json",
        "simple/valueset-filter-isa.json",
        "simple/valueset-filter-child-of.json",
