{
  "name": "@cosyte/terminology",
  "version": "0.1.3",
  "description": "Terminology engine for US healthcare code systems in Node.js and TypeScript: FHIR $translate, $lookup, $validate-code, and $expand over code systems, value sets, and maps you supply.",
  "keywords": [
    "terminology",
    "fhir",
    "healthcare",
    "interoperability",
    "typescript",
    "code-systems",
    "conceptmap",
    "valueset",
    "ucum",
    "rxnorm",
    "loinc",
    "snomed-ct",
    "icd-10"
  ],
  "homepage": "https://docs.cosyte.com/terminology",
  "bugs": {
    "url": "https://github.com/cosyte/terminology/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosyte/terminology.git"
  },
  "license": "MIT",
  "author": "Cosyte <hello@cosyte.com> (https://cosyte.com)",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "minimatch@>=10.0.0 <11.0.1": "11.0.1"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "vendor/ucum/NOTICE.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "prettier": "@cosyte/prettier-config",
  "scripts": {
    "build": "cosyte-process build",
    "changeset": "changeset",
    "gen:ucum": "tsx scripts/generate-ucum-essence-data.ts",
    "conformance:tx": "tsx scripts/tx-conformance.ts",
    "typecheck": "cosyte-process typecheck",
    "phi-scan": "tsx scripts/phi-scan.ts",
    "check:no-internal-refs": "bash scripts/check-no-internal-refs.sh",
    "check:no-emdash": "node scripts/check-no-emdash.mjs",
    "check:agent-notes": "cosyte-agent-notes",
    "check:catalog": "cosyte-catalog",
    "check:claude-card": "cosyte-claude-card",
    "check:readme": "cosyte-readme",
    "check:process": "cosyte-process check",
    "lint": "cosyte-process lint",
    "lint:fix": "cosyte-process lint --fix",
    "format": "cosyte-process format",
    "format:check": "cosyte-process format --check",
    "test": "cosyte-process test",
    "test:watch": "cosyte-process test --watch",
    "test:coverage": "cosyte-process test --coverage",
    "examples": "tsx scripts/run-examples.ts",
    "clean": "rm -rf dist coverage",
    "pack:docs": "bash scripts/build-docs-artifacts.sh",
    "attw": "cosyte-attw",
    "version": "changeset version && node scripts/sync-version.mjs && prettier --write package.json CHANGELOG.md src/index.ts",
    "release": "changeset publish",
    "prepublishOnly": "pnpm clean && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm attw",
    "prepare": "command -v simple-git-hooks >/dev/null 2>&1 && simple-git-hooks 1>&2 || true"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm phi-scan --staged"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.4",
    "@changesets/cli": "2.31.0",
    "@cosyte/eslint-config": "^0.1",
    "@cosyte/prettier-config": "^0.1",
    "@cosyte/process": "^0.1",
    "@cosyte/script-utils": "^0.1.5",
    "@cosyte/test-utils": "^0.1",
    "@cosyte/tsconfig": "^0.1",
    "@cosyte/tsup-config": "^0.1",
    "@cosyte/vitest-config": "^0.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.5.0",
    "fast-check": "3.23.2",
    "prettier": "3.8.3",
    "simple-git-hooks": "2.13.0",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "dependencies": {}
}
